APP_NAME="Base Shop"
APP_ENV=local
APP_DEBUG=true
# URL mở website trên trình duyệt (không có dấu / ở cuối)
APP_URL=http://localhost/base

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=base_shop
DB_USERNAME=root
DB_PASSWORD=

# true khi chạy sau Cloudflare Tunnel: lấy IP thật của khách từ header CF-Connecting-IP
TRUST_PROXY=false

SESSION_NAME=base_session
SESSION_LIFETIME=120

# ===== SePay sandbox =====
# Đăng ký tại https://my.sepay.vn → Payment Gateway → Register → Start now → chọn Sandbox
# Copy MERCHANT ID và SECRET KEY (SECRET KEY chỉ hiện 1 lần!)
SEPAY_ENABLED=true
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Khoá IPN do bạn tự đặt trên dashboard (Configuration → IPN), SePay gửi trong header X-Secret-Key
SEPAY_IPN_SECRET=
# true: khi khách quay về success_url, server tự hỏi API SePay để cập nhật đơn (dùng khi chạy localhost)
SEPAY_RECONCILE_ON_RETURN=true
